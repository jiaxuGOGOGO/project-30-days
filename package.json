  "private": true,
  "description": "Project 30-Days PHASE 1: PostgreSQL, Redis and Prisma data model for an anonymous limited-time social experiment.",
  "license": "UNLICENSED",
  "scripts": {
    "db:up": "docker compose up -d postgres redis",
