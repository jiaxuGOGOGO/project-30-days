{
  "name": "project-30-days",
  "version": "0.2.0",
  "private": true,
  "description": "Project 30-Days: Anonymous limited-time social experiment with Progressive Trust Reveal, DailyEcho, Boarding Hall, and Season system.",
  "license": "UNLICENSED",
  "scripts": {
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name phase1_init",
    "prisma:seed": "tsx prisma/seed.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "cross-env E2E_CONCURRENCY=20 tsx test/e2e-simulation.spec.ts",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "frontend:build:weapp": "cd frontend && taro build --type weapp",
    "frontend:build:h5": "cd frontend && taro build --type h5"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-ws": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "^5.22.0",
    "@tarojs/components": "^3.6.40",
    "@tarojs/react": "^3.6.40",
    "@tarojs/runtime": "^3.6.40",
    "@tarojs/taro": "^3.6.40",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tarojs/cli": "^3.6.40",
    "@tarojs/plugin-framework-react": "^3.6.40",
    "@tarojs/plugin-platform-h5": "^3.6.40",
    "@tarojs/plugin-platform-weapp": "^3.6.40",
    "@tarojs/webpack5-runner": "^3.6.40",
    "@types/matter-js": "^0.19.8",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "babel-preset-taro": "3.6.40",
    "postcss": "^8.5.14",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@nestjs/core",
      "@prisma/engines",
      "@swc/core",
      "@tarojs/binding",
      "esbuild",
      "prisma",
      "swiper"
    ]
  }
}
