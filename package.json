{
  "name": "project-30-days",
  "version": "0.2.0",
  "private": true,
  "description": "Project 30-Days: Anonymous limited-time social experiment with Progressive Trust Reveal, DailyEcho, Boarding Hall, and Season system.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/src/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:build": "tsc -p tsconfig.test.json",
    "test:e2e": "pnpm test:build && node dist/test/test/e2e-simulation.spec.js",
    "test:baseline": "pnpm build && node --test test/baseline.spec.cjs",
    "test:model": "node test/social-simulation.cjs --self-test",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "frontend:build:weapp": "cd frontend && taro build --type weapp",
    "frontend:build:h5": "cd frontend && taro build --type h5"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/platform-ws": "11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/websockets": "11.2.5",
    "@prisma/client": "^5.22.0",
    "@tarojs/components": "3.6.40",
    "@tarojs/react": "3.6.40",
    "@tarojs/runtime": "3.6.40",
    "@tarojs/shared": "3.6.40",
    "@tarojs/taro": "3.6.40",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "8.21.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tarojs/cli": "3.6.40",
    "@tarojs/helper": "3.6.40",
    "@tarojs/plugin-framework-react": "3.6.40",
    "@tarojs/plugin-platform-h5": "3.6.40",
    "@tarojs/plugin-platform-weapp": "3.6.40",
    "@tarojs/webpack5-runner": "3.6.40",
    "@types/matter-js": "^0.19.8",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "babel-preset-taro": "3.6.40",
    "postcss": "^8.5.14",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsc-watch": "7.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
