generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ACTIVE
  WATCHER
  /// OBSERVER: Upgraded WATCHER with special privileges (P2)
  OBSERVER

  @@map("user_role")
}

enum RoomStatus {
  BOARDING
  RECRUITING
  RUNNING
  DESTROYED

  @@map("room_status")
}

enum ConnectionStatus {
  YOMI_MATCHING
  SANDGLASS_24H
  DEEP_LINK
  JUDGMENT
  DESTROYED

  @@map("connection_status")
}

enum Decision {
  NULL
  DEFECT
  COOPERATE

  @@map("decision")
}

enum RevealLevel {
  SILHOUETTE
  FROSTED
  NEAR
  FULL

  @@map("reveal_level")
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  wechat_openid    String       @unique @db.VarChar(128)
  /// Original video is stored encrypted; only server-side transcoded variants are served
  shadow_video_url String       @db.Text
  fire_points      Int          @default(3)
  role             UserRole     @default(ACTIVE)
  /// Tracks when video assets were destroyed (for compliance audit)
  video_destroyed_at DateTime?  @db.Timestamptz(6)
  /// P2: Hourglass freezes remaining this season (default 2)
  freeze_remaining Int          @default(2)
  /// P2: Stardust fragments accumulated across seasons
  stardust_fragments Int        @default(0)
  /// P2: Current season number the user is participating in
  current_season   Int          @default(1)
  /// P2: Whether user achieved LEGACY in previous season (glow effect)
  legacy_badge     Boolean      @default(false)
  /// P2: Observer fragments accumulated while in WATCHER/OBSERVER role
  observer_fragments Int        @default(0)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)

  connections_as_a Connection[] @relation("ConnectionUserA")
  connections_as_b Connection[] @relation("ConnectionUserB")
  hourglass_freezes HourglassFreeze[]
  stardust_tickets  StardustTicket[]

  @@index([role])
  @@index([created_at])
  @@map("users")
}

model InstanceRoom {
  id            String       @id @default(uuid()) @db.Uuid
  max_users     Int          @default(100)
  /// Minimum users required before the room can transition from BOARDING to RUNNING
  min_users     Int          @default(50)
  start_date    DateTime     @db.Timestamptz(6)
  /// Database-level invariant is enforced in migration SQL:
  /// end_date must equal start_date + interval '30 days'.
  end_date      DateTime     @db.Timestamptz(6)
  status        RoomStatus   @default(BOARDING)
  /// Scheduled departure time for BOARDING rooms
  scheduled_at  DateTime?    @db.Timestamptz(6)
  /// Current number of users in the boarding queue
  boarding_count Int         @default(0)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)

  connections Connection[]

  @@index([status, start_date])
  @@index([status, scheduled_at])
  @@index([end_date])
  @@map("instance_rooms")
}

model FateCard {
  id            String   @id @default(uuid()) @db.Uuid
  question_text String   @unique @db.Text
  option_a      String   @db.Text
  option_b      String   @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("fate_cards")
}

model Connection {
  id                   String           @id @default(uuid()) @db.Uuid
  user_a_id            String           @db.Uuid
  user_b_id            String           @db.Uuid
  room_id              String           @db.Uuid
  status               ConnectionStatus @default(YOMI_MATCHING)
  connected_days       Int              @default(0)
  user_a_decision      Decision         @default(NULL)
  user_b_decision      Decision         @default(NULL)
  sandglass_started_at DateTime?        @db.Timestamptz(6)
  deep_link_started_at DateTime?        @db.Timestamptz(6)
  judgment_started_at  DateTime?        @db.Timestamptz(6)
  destroyed_at         DateTime?        @db.Timestamptz(6)
  /// P1: Tracks judgment round (1 = first, 2 = after extension/cooldown)
  judgment_round       Int              @default(1)
  /// P2: Season number this connection belongs to
  season               Int              @default(1)
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @updatedAt @db.Timestamptz(6)

  user_a User         @relation("ConnectionUserA", fields: [user_a_id], references: [id], onDelete: Cascade)
  user_b User         @relation("ConnectionUserB", fields: [user_b_id], references: [id], onDelete: Cascade)
  room   InstanceRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  daily_echoes DailyEcho[]
  hourglass_freezes HourglassFreeze[]
  stardust_tickets  StardustTicket[]

  @@index([room_id, status])
  @@index([user_a_id, room_id, status])
  @@index([user_b_id, room_id, status])
  @@index([status, sandglass_started_at])
  @@index([status, connected_days])
  @@index([season])
  @@map("connections")
}

/// DailyEcho: Lightweight daily double-blind Q&A to maintain engagement during Day 2-29.
/// Both users must answer before they can see each other's response.
/// Video reveal progress only advances when both answer.
model DailyEcho {
  id            String   @id @default(uuid()) @db.Uuid
  connection_id String   @db.Uuid
  day_number    Int
  prompt_text   String   @db.Text
  user_a_answer String?  @db.Text
  user_b_answer String?  @db.Text
  both_answered Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  answered_at   DateTime? @db.Timestamptz(6)

  connection Connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, day_number])
  @@index([connection_id, both_answered])
  @@map("daily_echoes")
}

/// P2: Hourglass Freeze — allows users to pause the 24h sandglass timer.
/// Each user gets 2 freezes per season. Cannot accumulate across seasons.
model HourglassFreeze {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  connection_id String   @db.Uuid
  /// The day number when freeze was used
  used_on_day   Int
  /// Season in which this freeze was used
  season        Int      @default(1)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@index([user_id, season])
  @@index([connection_id])
  @@map("hourglass_freezes")
}

/// P2: Stardust Ticket — redesigned as a "growth record" rather than failure proof.
/// Contains personality insights, best DailyEcho answers, and connection statistics.
model StardustTicket {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  connection_id   String   @db.Uuid
  /// Season this ticket belongs to
  season          Int      @default(1)
  /// Final outcome: LEGACY or ASH
  outcome         String   @db.VarChar(16)
  /// Number of days both users participated
  participated_days Int    @default(0)
  /// Number of DailyEcho exchanges completed
  echo_count      Int      @default(0)
  /// AI-generated personality tags based on choices (JSON array)
  growth_tags     String   @default("[]") @db.Text
  /// Top 3 DailyEcho answers selected for the ticket (JSON array)
  highlight_answers String @default("[]") @db.Text
  /// Soul graph summary text
  soul_summary    String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([user_id, connection_id])
  @@index([user_id, season])
  @@map("stardust_tickets")
}

/// P2: Season — tracks global season metadata for the seasonal cycle system.
model Season {
  id            String   @id @default(uuid()) @db.Uuid
  season_number Int      @unique
  /// Theme for this season's FateCards
  theme         String   @db.VarChar(128)
  starts_at     DateTime @db.Timestamptz(6)
  ends_at       DateTime @db.Timestamptz(6)
  is_active     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_active])
  @@map("seasons")
}
