DATABASE_URL="postgresql://project30:project30_dev_password@localhost:5432/project30?schema=public"
REDIS_URL="redis://:project30_redis_password@localhost:6379/0"
PORT=3000

# --- Phase 0: Media Service ---
# Cloud storage bucket for video variants (server-side transcoding)
MEDIA_STORAGE_BUCKET=project30-media
# Signed URL expiration time in seconds (default: 1 hour)
SIGNED_URL_TTL_SECONDS=3600
# Cloud provider credentials (Tencent Cloud COS example)
# COS_SECRET_ID=your_secret_id
# COS_SECRET_KEY=your_secret_key
# COS_REGION=ap-shanghai

# --- P1: WebSocket ---
# Native ws is used instead of Socket.IO for WeChat compatibility
# WS_PATH=/events

# --- P2: Season System ---
# Default season theme
# SEASON_DEFAULT_THEME=命运的第一次碰撞
# Hourglass freezes per user per season
# HOURGLASS_FREEZE_PER_SEASON=2

# --- H5 Deployment ---
# Frontend API base URL (for H5 build)
# TARO_APP_API_BASE=https://your-domain.com/api
# WeChat JS-SDK App ID (for H5 sharing)
# WECHAT_H5_APP_ID=your_wechat_app_id
